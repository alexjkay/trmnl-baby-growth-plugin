<div class="layout layout--col layout--center-x gap--large flex--evenly">
  {% if date_valid == false %}
    <span class="title">Select your due date</span>
    <span class="description">Choose a due date in the plugin settings.</span>
  {% elsif status == "born" %}
    <span class="value value--xlarge">Baby has arrived!</span>
    <span class="description">Congratulations - the due date was {{ due_label }}.</span>
  {% else %}
    <div class="grid grid--cols-2 w--full grow">
      <div class="flex flex--col flex--center-x flex--evenly self--stretch">
        <span class="label lg:text--xlarge">{% if status == "early" %}Before week 1{% else %}Week {{ preg_week }}{% if preg_day > 0 %} + {{ preg_day }}d{% endif %} - {{ trimester }}{% endif %}</span>
        <span class="description lg:text--xlarge">Your baby is the size of {{ size_article }}</span>
        <span class="value value--xlarge w--full text--center">{{ size_object | capitalize }}</span>
        {% if size_image_url != "" %}
          <img class="image image-dither self--center w--24 h--24 lg:w--40 lg:h--40" src="{{ size_image_url }}" alt="{{ size_object | capitalize }}" width="96" height="96">
        {% endif %}
        <div class="grid grid--cols-2 w--full text--center">
          <div class="item">
            <div class="meta"></div>
            <div class="content flex flex--col flex--center-x w--full">
              <span class="value lg:value--large">{{ size_length }}</span>
              <span class="label lg:label--large">Length</span>
            </div>
          </div>
          <div class="item">
            <div class="meta"></div>
            <div class="content flex flex--col flex--center-x w--full">
              <span class="value lg:value--large">{{ size_weight }}</span>
              <span class="label lg:label--large">Weight</span>
            </div>
          </div>
        </div>
      </div>
      <div class="flex flex--col flex--center-x text--center h--full flex--evenly self--stretch">
        <span class="value value--tnums value--mega portrait:value--xxxlarge">{{ count_value }}</span>
        <span class="label text--xxlarge">{{ count_label }}</span>
        {% if status == "pregnant" or status == "early" %}
          <span class="description text--base lg:text--xlarge">{{ weeks_left }} {{ weeks_word }}, {{ days_rem }} {{ days_word }}</span>
        {% endif %}
        <span class="description text--base lg:text--xxlarge">Due {{ due_label }}</span>
      </div>
    </div>
    <div class="flex flex--row flex--between w--full">
      <span class="label">Pregnancy progress</span>
      <span class="label">{{ progress_pct }}%</span>
    </div>
    <div class="progress-bar w--full">
      <div class="track"><div class="fill" style="width: {{ progress_pct }}%"></div></div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ display_title | escape }}</span>
  <span class="instance">{% if date_valid %}Due {{ due_label }}{% endif %}</span>
</div>
