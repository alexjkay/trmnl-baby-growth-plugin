<div class="layout layout--col layout--center gap--large">
  {% if date_valid == false %}
    <span class="title">Set your due date</span>
    <span class="description">Enter it as DD/MM/YYYY in the plugin settings.</span>
  {% elsif status == "born" %}
    <span class="value value--xlarge">Baby has arrived!</span>
    <span class="description">Congratulations - the due date was {{ due_label }}.</span>
  {% else %}
    <div class="columns">
      <div class="column">
        <span class="label">{% if status == "early" %}Before week 1{% else %}Week {{ preg_week }}{% if preg_day > 0 %} + {{ preg_day }}d{% endif %} - {{ trimester }}{% endif %}</span>
        <span class="description">Baby is the size of {{ size_article }}</span>
        <span class="value value--xlarge">{{ size_object | capitalize }}</span>
        {% if size_image_url != "" %}
          <a href="{{ size_image_url }}"><img src="{{ size_image_url }}" alt="{{ size_object | capitalize }}" width="96" height="96"></a>
          <a href="{{ size_image_url }}">View image</a>
        {% endif %}
        <div class="flex gap--large">
          <div class="item">
            <div class="content">
              <span class="value value--small">{{ size_length }}</span>
              <span class="label label--small">Length</span>
            </div>
          </div>
          <div class="item">
            <div class="content">
              <span class="value value--small">{{ size_weight }}</span>
              <span class="label label--small">Weight</span>
            </div>
          </div>
        </div>
      </div>
      <div class="column">
        <span class="value value--xxxlarge value--tnums">{{ count_value }}</span>
        <span class="label">{{ count_label }}</span>
        {% if status == "pregnant" or status == "early" %}
          <span class="description">{{ weeks_left }} {{ weeks_word }}, {{ days_rem }} {{ days_word }}</span>
        {% endif %}
        <span class="description">Due {{ due_label }}</span>
      </div>
    </div>
    <div class="progress-bar">
      <div class="content">
        <span class="label">Pregnancy progress</span>
        <span class="label">{{ progress_pct }}%</span>
      </div>
      <div class="track">
        <div class="fill" style="width: {{ progress_pct }}%"></div>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Baby Growth</span>
  <span class="instance">{% if date_valid %}Due {{ due_label }}{% endif %}</span>
</div>
