<div class="layout layout--col layout--center">
  {% if date_valid == false %}
    <span class="title">Set your due date</span>
  {% elsif status == "born" %}
    <span class="value">Baby has arrived!</span>
  {% else %}
    <span class="value value--large">{{ size_object | capitalize }}</span>
    <span class="description">{{ size_length }} - {{ size_weight }}</span>
    <span class="value value--tnums">{{ count_value }}</span>
    <span class="label label--small">{{ count_label }}</span>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">Baby Growth</span>
</div>
