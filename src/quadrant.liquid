<div class="layout layout--col layout--center-x flex--evenly">
  {% if date_valid == false %}
    <span class="title">Set your due date</span>
    <span class="description lg:text--large">DD/MM/YYYY</span>
  {% elsif status == "born" %}
    <span class="value">Baby has arrived!</span>
  {% else %}
    <div class="columns w--full grow">
      <div class="column flex flex--col flex--center-x flex--evenly self--stretch text--center">
        <span class="value value--xsmall lg:value--small">{{ size_object | capitalize }}</span>
        {% if size_image_url != "" %}
          <img class="image image-dither w--14 h--14 lg:w--24 lg:h--24" src="{{ size_image_url }}" alt="{{ size_object | capitalize }}" width="56" height="56">
        {% endif %}
        <span class="description lg:text--large">{{ size_length }} - {{ size_weight }}</span>
      </div>
      <div class="column flex flex--col flex--center-x flex--evenly self--stretch text--center">
        <span class="value value--tnums value--large lg:value--xxlarge portrait:value--base">{{ count_value }}</span>
        <span class="label text--base lg:text--large">{{ count_label }}</span>
      </div>
    </div>
    <div class="flex flex--row flex--between w--full">
      <span class="label lg:text--large">Pregnancy progress</span>
      <span class="label lg:text--large">{{ progress_pct }}%</span>
    </div>
    <div class="progress-bar progress-bar--xsmall w--full">
      <div class="track"><div class="fill" style="width: {{ progress_pct }}%"></div></div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ display_title | escape }}</span>
</div>
