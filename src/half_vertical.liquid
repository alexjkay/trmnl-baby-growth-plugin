<div class="layout layout--col layout--center-x flex--evenly text--center">
  {% if date_valid == false %}
    <span class="title">Set your due date</span>
    <span class="label label--small">DD/MM/YYYY format required</span>
  {% elsif status == "born" %}
    <span class="value value--large">Baby has arrived!</span>
  {% else %}
    <div class="flex flex--col flex--center-x flex--evenly self--stretch grow">
      <span class="label lg:text--large">{% if status == "early" %}Before week 1{% else %}Week {{ preg_week }}{% if preg_day > 0 %} + {{ preg_day }}d{% endif %}{% endif %}</span>
      <span class="description lg:text--large">Size of {{ size_article }}</span>
      <span class="value w--full value--small lg:value--base">{{ size_object | capitalize }}</span>
      {% if size_image_url != "" %}
        <img class="image image-dither self--center w--20 h--20 lg:w--32 lg:h--32" src="{{ size_image_url }}" alt="{{ size_object | capitalize }}" width="80" height="80">
      {% endif %}
      <span class="description lg:text--large">{{ size_length }} - {{ size_weight }}</span>
      <span class="value value--tnums value--xxxlarge portrait:value--xxlarge">{{ count_value }}</span>
      <span class="label text--xlarge lg:text--xxlarge">{{ count_label }}</span>
    </div>
    <div class="flex flex--col flex--evenly w--full">
      <div class="flex flex--row flex--between w--full">
        <span class="label lg:text--large">Pregnancy progress</span>
        <span class="label lg:text--large">{{ progress_pct }}%</span>
      </div>
      <div class="progress-bar progress-bar--small w--full">
        <div class="track"><div class="fill" style="width: {{ progress_pct }}%"></div></div>
      </div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ display_title | escape }}</span>
</div>
