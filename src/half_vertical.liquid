<div class="layout layout--col layout--center gap--xsmall text--center">
  {% if date_valid == false %}
    <span class="title">Set your due date</span>
    <span class="description">DD/MM/YYYY</span>
  {% elsif status == "born" %}
    <span class="value value--large">Baby has arrived!</span>
  {% else %}
    <span class="label">{% if status == "early" %}Before week 1{% else %}Week {{ preg_week }}{% if preg_day > 0 %} + {{ preg_day }}d{% endif %}{% endif %}</span>
    <span class="description">Size of {{ size_article }}</span>
    <span class="value w--full text--xlarge">{{ size_object | capitalize }}</span>
    {% if size_image_url != "" %}
      <a href="{{ size_image_url }}" class="self--center"><img class="image image-dither" src="{{ size_image_url }}" alt="{{ size_object | capitalize }}" width="80" height="80"></a>
    {% endif %}
    <span class="description">{{ size_length }} - {{ size_weight }}</span>
    <span class="value value--tnums text--tera portrait:text--giga">{{ count_value }}</span>
    <span class="label text--xlarge">{{ count_label }}</span>
    <div class="progress-bar progress-bar--small w--full">
      <div class="content">
        <span class="label">Pregnancy progress</span>
        <span class="label">{{ progress_pct }}%</span>
      </div>
      <div class="track"><div class="fill" style="width: {{ progress_pct }}%"></div></div>
    </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ display_title | escape }}</span>
</div>
