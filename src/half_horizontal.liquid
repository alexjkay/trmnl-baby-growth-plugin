<div class="layout layout--col layout--center gap--small">
  {% if date_valid == false %}
    <span class="title">Set your due date (DD/MM/YYYY)</span>
  {% elsif status == "born" %}
    <span class="value value--large">Baby has arrived!</span>
  {% else %}
    <div class="columns w--full">
      <div class="column flex flex--col flex--center gap--xsmall text--center">
        <span class="label">{% if status == "early" %}Before week 1{% else %}Week {{ preg_week }}{% if preg_day > 0 %} + {{ preg_day }}d{% endif %}{% endif %} - size of {{ size_article }}</span>
        <span class="value text--xlarge">{{ size_object | capitalize }}</span>
        {% if size_image_url != "" %}
          <img class="image image-dither" src="{{ size_image_url }}" alt="{{ size_object | capitalize }}" width="56" height="56">
        {% endif %}
        <span class="description">{{ size_length }} - {{ size_weight }}</span>
      </div>
      <div class="column flex flex--col flex--center gap--small text--center">
        <span class="value value--tnums text--giga portrait:text--xxxlarge">{{ count_value }}</span>
        <span class="label text--large">{{ count_label }}</span>
      </div>
    </div>
    <div class="flex flex--row flex--between w--full">
      <span class="label">Pregnancy progress</span>
      <span class="label">{{ progress_pct }}%</span>
    </div>
    {% if local_preview %}
      <div class="progress-bar progress-bar--small w--full">
        <div class="track"><div class="fill" style="width: {{ progress_pct }}%"></div></div>
      </div>
    {% else %}
      <div class="progress-bar progress-bar--small w--full" data-progress="{{ progress_pct }}"></div>
    {% endif %}
  {% endif %}
</div>

<div class="title_bar">
  <span class="title">{{ display_title | escape }}</span>
  <span class="instance">{% if date_valid %}Due {{ due_label }}{% endif %}</span>
</div>
